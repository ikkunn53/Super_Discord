DISCORD_TOKEN=YOUR_BOT_TOKEN
CONSOLE_CHANNEL_ID=YOUR_CONSOLE_CHANNEL_ID

# Web管理画面で通知先チャンネル一覧を読み込むDiscordサーバーID（任意）
# 空欄の場合は CONSOLE_CHANNEL_ID が所属するサーバーを使用します。
WEB_GUILD_ID=

# Log channel (optional but recommended)
LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID

WEB_PORT=3000
DB_PATH=./app.db

# Twitch Helix API (required for Twitch live detection)
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET

# Monitoring tuning
BATCH_SIZE=30
BATCH_INTERVAL_MS=6000
HTTP_TIMEOUT_MS=15000
FEED_MAX_BYTES=2097152
BACKFILL_DAYS=2
JOB_TIMEOUT_MS=20000
JOB_STALE_MS=60000
JOB_FORCE_RELEASE_STALE=0
JOB_STALE_HARD_RELEASE_MS=600000
